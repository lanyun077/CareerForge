# ===== 大模型（OpenAI-compatible API）=====
# 不配置时系统进入“题库兜底模式”：固定题库 + 规则评分，仍可完整跑通演示闭环
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 扫描 PDF OCR（可选，使用支持图片输入的兼容模型，例如 qwen-vl-plus） =====
OCR_MODEL=qwen-vl-plus
OCR_API_KEY=
OCR_BASE_URL=

# ===== 语音转写 ASR（可选能力，不配置时使用文字输入）=====
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1

# ===== 数据库（Supabase / PostgreSQL，后续接入；当前版本使用内存存储）=====
DATABASE_URL=
